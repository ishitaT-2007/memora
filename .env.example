# Accrue MVP — copy to .env and adjust. Never commit real secrets.

APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# SQLite for zero-setup local demo. Postgres example:
# DATABASE_URL=postgresql+psycopg://accrue:accrue@localhost:5432/accrue
DATABASE_URL=sqlite:///./backend/data/accrue.db

RETAIN_RAW_INPUT=true
MAX_ESCALATION_CHARS=20000
ANALYZE_RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=45

# Auth (demo users are seeded; change before any real data)
JWT_EXPIRE_MINUTES=480
DEMO_CSM_EMAIL=csm@accrue.demo
DEMO_CSM_PASSWORD=AccrueDemo!2026
DEMO_ADMIN_EMAIL=admin@accrue.demo
DEMO_ADMIN_PASSWORD=AccrueAdmin!2026

# Memory: mock (default) or hindsight
HINDSIGHT_MODE=mock
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=20

# LLM: mock (default), groq, or openai
LLM_MODE=mock
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=30
